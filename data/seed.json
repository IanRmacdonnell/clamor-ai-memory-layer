        { "id": "m1", "channelId": "announcements", "author": "Maya", "time": "9:04 AM", "text": "Reminder: Thursday's PM speaker panel is moving to Baker 114 because the library room is booked.", "tags": ["deadline"], "important": true, "createdAt": "2026-05-27T16:04:00.000Z" },
        { "id": "m2", "channelId": "events", "author": "Leo", "time": "9:18 AM", "text": "Can someone update the flyer? The old one still says Library 202 and we already posted it in two channels.", "tags": ["question", "task"], "important": true, "createdAt": "2026-05-27T16:18:00.000Z" },
        { "id": "m3", "channelId": "events", "author": "Ari", "time": "9:33 AM", "text": "I can update the flyer by 2 PM. Need the sponsor logo from the drive first.", "tags": ["task", "deadline", "risk"], "important": true, "createdAt": "2026-05-27T16:33:00.000Z" },
        { "id": "m4", "channelId": "leadership", "author": "Nina", "time": "10:02 AM", "text": "Budget update: ASI approved $450, not $600. Final decision was pizza plus drinks, no merch this time.", "tags": ["decision"], "important": true, "createdAt": "2026-05-27T17:02:00.000Z" },
        { "id": "m5", "channelId": "events", "author": "Sam", "time": "10:21 AM", "text": "I dropped the sponsor logo in Drive: /PM-Club/Spring-Panel/sponsor-logo.png", "tags": ["link"], "important": true, "createdAt": "2026-05-27T17:21:00.000Z" },
        { "id": "m6", "channelId": "events", "author": "Priya", "time": "11:08 AM", "text": "Do we need volunteers at 5:15 or 5:30? I keep seeing both times.", "tags": ["question", "deadline"], "important": true, "createdAt": "2026-05-27T18:08:00.000Z" },
        { "id": "m7", "channelId": "announcements", "author": "Maya", "time": "11:16 AM", "text": "Volunteer call time is 5:15. Doors open at 5:45. Panel starts at 6:00.", "tags": ["deadline"], "important": true, "createdAt": "2026-05-27T18:16:00.000Z" },
        { "id": "m8", "channelId": "events", "author": "Ben", "time": "12:01 PM", "text": "We still need one person to handle check-in and one person to take photos for the recap post.", "tags": ["task", "risk"], "important": true, "createdAt": "2026-05-27T19:01:00.000Z" },
        { "id": "m9", "channelId": "general", "author": "Jules", "time": "12:22 PM", "text": "For new members: tonight's meeting is a casual prep session. Bring laptop if you want feedback on your resume.", "tags": ["onboarding", "task"], "important": true, "createdAt": "2026-05-27T19:22:00.000Z" },
