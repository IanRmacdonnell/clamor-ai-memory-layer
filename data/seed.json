        { "id": "h1", "channelId": "strategy", "author": "Eli", "time": "8:41 PM", "text": "We are committing to the campus safety idea. The group liked the AI route planner better than the dining hall app.", "tags": ["decision"], "important": true, "createdAt": "2026-05-27T03:41:00.000Z" },
        { "id": "h2", "channelId": "pitch", "author": "Tara", "time": "8:49 PM", "text": "Deadline check: pitch deck is due Sunday at noon, walkthrough video by 4 PM.", "tags": ["deadline"], "important": true, "createdAt": "2026-05-27T03:49:00.000Z" },
        { "id": "h3", "channelId": "build", "author": "Owen", "time": "9:10 PM", "text": "Map API is rate limiting us. I can cache routes locally if we keep the presentation to three sample locations.", "tags": ["risk", "task"], "important": true, "createdAt": "2026-05-27T04:10:00.000Z" },
        { "id": "h4", "channelId": "pitch", "author": "Riya", "time": "9:44 PM", "text": "I made the landing copy less dramatic. It now says safer night walks with friend-aware routing.", "tags": [], "important": false, "createdAt": "2026-05-27T04:44:00.000Z" },
        { "id": "h5", "channelId": "strategy", "author": "Eli", "time": "10:17 PM", "text": "Final MVP scope: route risk score, buddy notification, and one admin dashboard. No live police scanner.", "tags": ["decision", "risk"], "important": true, "createdAt": "2026-05-27T05:17:00.000Z" }
